#InlineTagRibbon {
    background-color: transparent;
}

#InlineTagRibbon QPushButton#tagRibbonButton {
    background-color: @TOPBAR_SURFACE@;
    border: none;
    border-radius: @TAG_CHIP_RADIUS@px;
    color: @TEXT_MUTED@;
    font-size: @FONT_SIZE_TAG@px;
    padding: @TAG_CHIP_PADDING_V@px @TAG_CHIP_PADDING_H@px;
}

#InlineTagRibbon QPushButton#tagRibbonButton[selected="true"] {
    background-color: @TAG_ACCENT@;
    color: @TOPBAR_ACTIVE@;
}

#InlineTagRibbon QPushButton#tagRibbonButton:focus {
    border: @ALPHABET_FOCUS_RING_WIDTH@px solid @WHITE@;
}
