#RecentWatchList {
    background: transparent;
    border: none;
    outline: none;
}

#RecentWatchList::item {
    border: none;
    padding: 0;
    background: transparent;
}

#RecentWatchList::item:selected {
    background: transparent;
}

#RecentWatchList::item:selected:active {
    background: transparent;
}

#RecentWatchList QScrollBar:vertical,
#RecentWatchList QScrollBar:horizontal {
    width: 0;
    height: 0;
    background: transparent;
}
