#LibraryStatusBar {
    background-color: @SIDEBAR_BG@;
    border-top: 1px solid @SIDEBAR_DIVIDER@;
    margin: 0;
    padding: 0;
}

#LibraryStatusBar QLabel#statusText {
    color: @SIDEBAR_TEXT@;
    font-family: @FONT_FAMILY_MONO@;
    font-size: @FONT_SIZE_XS@px;
    margin: 0;
    padding: @SPACE_SM@px;
}
